{
  "version": 1,
  "author": "Mary Grace Soronio",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-stm32-bluepill",
      "id": "stm32",
      "top": 100,
      "left": 0,
      "attrs": { "builder": "platformio-stm32" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht22",
      "top": 60,
      "left": 340,
      "attrs": { "temperature": "25.4", "humidity": "61.2" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_dht",
      "top": 180,
      "left": 340,
      "rotate": 90,
      "attrs": { "value": "10000" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 300,
      "left": 340,
      "attrs": { "lux": "500" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 60,
      "left": 560,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-ky-040",
      "id": "encoder",
      "top": 400,
      "left": 340
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 470,
      "left": 560
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": 560,
      "left": 340
    }
  ],
  "connections": [
    [ "stm32:A10", "$serialMonitor:TX", "green", [] ],
    [ "stm32:A9", "$serialMonitor:RX", "green", [] ],
    [ "dht22:VCC", "stm32:3V3.1", "red", [] ],
    [ "dht22:GND", "stm32:GND.1", "black", [] ],
    [ "dht22:SDA", "stm32:A1", "blue", [] ],
    [ "r_dht:1", "stm32:3V3.1", "red", [] ],
    [ "r_dht:2", "stm32:A1", "blue", [] ],
    [ "ldr:VCC", "stm32:3V3.1", "red", [] ],
    [ "ldr:GND", "stm32:GND.1", "black", [] ],
    [ "ldr:AO", "stm32:A0", "orange", [] ],
    [ "oled:VCC", "stm32:3V3.1", "red", [] ],
    [ "oled:GND", "stm32:GND.2", "black", [] ],
    [ "oled:SCL", "stm32:B6", "purple", [] ],
    [ "oled:SDA", "stm32:B7", "purple", [] ],
    [ "encoder:CLK", "stm32:B12", "yellow", [] ],
    [ "encoder:DT", "stm32:B13", "orange", [] ],
    [ "encoder:SW", "stm32:B14", "blue", [] ],
    [ "encoder:VCC", "stm32:3V3.1", "red", [] ],
    [ "encoder:GND", "stm32:GND.1", "black", [] ],
    [ "stm32:B0", "buzzer:2", "green", [] ],
    [ "buzzer:1", "stm32:GND.1", "black", [] ],
    [ "pir:VCC", "stm32:3V3.1", "red", [] ],
    [ "pir:GND", "stm32:GND.1", "black", [] ],
    [ "pir:OUT", "stm32:B8", "orange", [] ]
  ],
  "serialMonitor": { "display": "always" },
  "dependencies": {}
}
